{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} [{Level:u3} [{SourceContext}] {Message:lj}{Exception}{NewLine}]"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Log_ConfigurationManager",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3} [{SourceContext}] {Message}{NewLine}{Exception}]"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId"
    ]
  },
  "DatabaseSettings": {
    "CrmDb": "CrmDb_ConfigurationManager"
  },
  "SecretSettings": {
    "SecretPassword": "SecretPassword_ENVIRONMENT",
    "SecretToken": "SecretToken_ENVIRONMENT"
  },
  "JwtToken": {
    "ValidIssuer": "CRM",
    "ValidAudience": "UI",
    "LifeTimeAccessToken": "1",
    "LifeTimeRefreshToken": "7"
  },
  "OpenApiSettings": {
    "Version": "v1",
    "Title": "CRM.API",
    "SecurityScheme": "Bearer",
    "Description": "Please enter token",
    "Name": "Authentication",
    "BearerFormat": "JWT"
  },
  "RabbitMqSettings":{
    "Host": "RabbitMqHost_ConfigurationManager",
    "UserName": "RabbitMqLogin_ConfigurationManager",
    "Password": "RabbitMqPassword_ConfigurationManager"
  },
  "ServicesUrlSettings": {
    "Crm": "CrmHost_ConfigurationManager",
    "TransactionStore": "TransactionStoreHost_ConfigurationManager"
  },
  "ConfigurationServiceSettings": {
    "ConfigurationServiceForCrm": "https://194.87.210.5:13000/api/configuration?service=1"
  }
}
